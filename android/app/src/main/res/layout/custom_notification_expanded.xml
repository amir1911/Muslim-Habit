<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notification_expanded_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="88dp"
    android:background="@drawable/notification_bg_gradient"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <!-- Maskot Nunu di dalam kartu squircle hijau -->
    <FrameLayout
        android:id="@+id/mascot_container_exp"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:background="@drawable/mascot_badge_bg">

        <ImageView
            android:id="@+id/notification_mascot_exp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Maskot Muslim Habit"
            android:padding="4dp"
            android:scaleType="fitCenter"
            android:src="@drawable/mascot_nunu" />
    </FrameLayout>

    <!-- Waktu di pojok kanan atas -->
    <TextView
        android:id="@+id/notification_time_exp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="2dp"
        android:fontFamily="sans-serif"
        android:text="10:00"
        android:textColor="#CBD5E1"
        android:textSize="12sp" />

    <!-- Konten Teks: Nama Aplikasi & Pesan Dinamis (Bisa lebih panjang) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="10dp"
        android:layout_toStartOf="@id/notification_time_exp"
        android:layout_toEndOf="@id/mascot_container_exp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/notification_app_title_exp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="Muslim Habbit"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/notification_message_exp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:maxLines="3"
            android:text="Jangan Lupa Untuk Melanjutkan Streakmu! Istiqamah dalam kebaikan bersama Nunu."
            android:textColor="#F8FAFC"
            android:textSize="12.5sp" />
    </LinearLayout>

</RelativeLayout>
